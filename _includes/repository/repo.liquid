<div class="repo p-2 w-100">
  <div class="github-local-card" data-github-repo="{{ include.repository | escape }}">
    <a class="github-card-title" href="https://github.com/{{ include.repository | escape }}">{{ include.repository | escape }}</a>
    <p data-repo-description>GitHub repository</p>
    <div class="github-card-stats" aria-live="polite">
      <span aria-label="Stars">⭐ <span data-repo-stars>—</span></span>
      <span>Forks <span data-repo-forks>—</span></span>
      <span data-repo-language></span>
    </div>
    <small data-repo-status aria-live="polite"></small>
  </div>
</div>
