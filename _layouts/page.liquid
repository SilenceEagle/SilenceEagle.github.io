---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.layout == 'project-doc' and page.last_modified_at %}
      {% assign modified_date = page.last_modified_at | date: '%Y-%m-%d' %}
      <p class="post-meta mb-3">最后修改于 <time datetime="{{ modified_date }}">{{ modified_date }}</time></p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>{{ site.data[site.active_lang].strings.references }}</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
